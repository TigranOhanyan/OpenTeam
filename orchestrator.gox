package openteam

import (
	"context"
	"database/sql"
	"encoding/json"
	"errors"
	"strings"
	"time"

	"github.com/oklog/ulid/v2"
	"github.com/openai/openai-go/v3/packages/param"
	"github.com/openteam/entities"
	"go.uber.org/zap"
)

var ErrEmptyOrchestrationPlan = errors.New("empty orchestration plan")

type StepTransferPlan struct {
	replyTaskId       *string
	mentionTaskIds []string
	actingTaskIds     []string
}

func (o *StepTransferPlan) isOnlyControl() bool {
	return o.replyTaskId == nil && len(o.mentionTaskIds) != 0 && len(o.actingTaskIds) == 0
}

func (o *StepTransferPlan) isFinalReply() bool {
	return o.replyTaskId != nil && len(o.mentionTaskIds) == 0 && len(o.actingTaskIds) == 0
}

func (o *StepTransferPlan) isEmpty() bool {
	return o.replyTaskId == nil && len(o.mentionTaskIds) == 0 && len(o.actingTaskIds) == 0
}

func (o *StepTransferPlan) getFirstStepId() (stepId string, err error) {
	if o.replyTaskId != nil {
		stepId = *o.replyTaskId
		return
	}

	if len(o.mentionTaskIds) > 0 {
		stepId = o.mentionTaskIds[0]
		return
	}
	if len(o.actingTaskIds) > 0 {
		stepId = o.actingTaskIds[0]
		return
	}

	err = ErrEmptyOrchestrationPlan
	return
}

func transfer121(
	ctx context.Context,
	qtx *entities.Queries,
	currentStepId string,
	nextStepKind EventKind,
	nextStepTaskId string,
	logger *zap.Logger,
) (
	nextStepId string,
	err error,
) {
	nextStepRecordParams := entities.CreateStepParams{
		ID:     ulid.Make().String(),
		TaskID: nextStepTaskId,
		Kind:   string(nextStepKind),
		Status: string(StepStatusPending),
	}
	nextStepRecord, err := qtx.CreateStep(ctx, nextStepRecordParams)
	if err != nil {
		logger.Error("failed to create current step", zap.Error(err))
		return
	}

	createStepLinkParams := entities.CreateStepLinkParams{
		PrevID: currentStepId,
		NextID: nextStepRecord.ID,
	}
	_, err = qtx.CreateStepLink(ctx, createStepLinkParams)
	if err != nil {
		logger.Error("failed to create step link", zap.Error(err))
		return
	}

	nextStepId = nextStepRecord.ID
	return
}

func (fanOut StepTransferPlan) transferFanOut(
	ctx context.Context,
	currentStepId string,
	logger *zap.Logger,
) (
	fanOutStepIds Plan,
	err error,
) {

	logger = logger.With(zap.String("currentStepId", currentStepId))
	logger.Info("getting current step...")
	currentStepRecord, err := a.ConversationHistoryDb.Queries.GetStep(ctx, currentStepId)
	logger = logger.With(zap.String("currentStepId", currentStepRecord.ID))

	logger.Info("getting task of current step...")
	taskOfcurrentStepRecord, err := a.ConversationHistoryDb.Queries.GetTaskByStep(ctx, currentStepRecord.ID)
	if err != nil {
		logger.Error("failed to get task", zap.Error(err))
		return
	}
	logger = logger.With(zap.String("taskId", taskOfcurrentStepRecord.ID))

	llmResponseAsMessage, messageId, err := a.llmResponseToMessage(ctx, currentStepRecord.ID, taskOfcurrentStepRecord, logger)
	if err != nil {
		logger.Error("failed to get llm response as message", zap.Error(err))
		return
	}

	logger = logger.With(zap.String("messageId", messageId))

	memberRecord, err := a.ConversationHistoryDb.Queries.GetMemberByTask(ctx, taskOfcurrentStepRecord.ID)
	if err != nil {
		logger.Error("failed to get name", zap.Error(err))
		return
	}

	roleOfcurrentStepRecord, er := a.ConversationHistoryDb.Queries.GetRoleByTask(ctx, taskOfcurrentStepRecord.ID)
	err = er
	if err != nil {
		logger.Error("failed to get role", zap.Error(err))
		return
	}

	logger = logger.With(zap.String("roleId", roleOfcurrentStepRecord.ID))
	logger.Info("getting channel...")

	channelRecord, er := a.ConversationHistoryDb.Queries.GetChannelByRole(ctx, roleOfcurrentStepRecord.ID)
	err = er
	if err != nil {
		logger.Error("failed to get channel", zap.Error(err))
		return
	}

	completedAt := time.Now().UTC()

	if param.IsOmitted(llmResponseAsMessage.OfAssistant) {
		err = UnexpectedMessageStructureError
		return
	}

	assistantMessage := llmResponseAsMessage.OfAssistant

	trx, err := a.ConversationHistoryDb.DB.BeginTx(ctx, nil)
	if err != nil {
		logger.Error("failed to begin transaction", zap.Error(err))
		return
	}

	defer trx.Rollback()
	qtx := a.ConversationHistoryDb.Queries.WithTx(trx)

	for _, toolCall := range assistantMessage.ToolCalls {
		if param.IsOmitted(toolCall.OfFunction) {
			continue
		}
		function := toolCall.OfFunction
		var args map[string]interface{}
		err = json.Unmarshal([]byte(function.Function.Arguments), &args)
		if err != nil {
			logger.Error("failed to unmarshal articulattion", zap.Error(err))
			return
		}
		if strings.EqualFold(function.Function.Name, addressToAgentFunction.Name) {

			fanOutStepId, er := a.handleMention(ctx, qtx, currentStepRecord, function.ID, channelRecord.Name, taskOfcurrentStepRecord.ID, args, logger)
			err = er
			if err != nil {
				logger.Error("failed to handle mention", zap.Error(err))
				return
			}
			fanOutStepIds.mentionStepIds = append(fanOutStepIds.mentionStepIds, fanOutStepId)
		} else {
			err = UnexpectedMessageStructureError
			return
		}
	}

	if !param.IsOmitted(assistantMessage.Content) {
		replyStepId, er := a.handleReply(ctx, qtx, currentStepRecord, llmResponseAsMessage, messageId, logger)
		err = er
		if err != nil {
			logger.Error("failed to handle reply", zap.Error(err))
			return
		}
		fanOutStepIds.replyTaskId = &replyStepId
		return
	}

	if !fanOutStepIds.isOnlyControl() {
		logger.Info("persisting message...")

		setName(&llmResponseAsMessage, memberRecord.Name)

		turnIntoUserMessage(&llmResponseAsMessage)

		filteredLlmResponseAsMessage := filterControlToolCalls(llmResponseAsMessage)

		filteredLlmResponseAsMessageBytes, er := json.Marshal(filteredLlmResponseAsMessage)
		err = er
		if err != nil {
			logger.Error("failed to marshal llm response as message", zap.Error(err))
			return
		}

		createMessageParams := entities.CreateMessageParams{
			ID:            messageId,
			Visibility:    string(VisibilityChannel),
			StepID:        currentStepRecord.ID,
			ChannelName:   channelRecord.Name,
			RoleID:        roleOfcurrentStepRecord.ID,
			TaskID:        taskOfcurrentStepRecord.ID,
			OpenaiMessage: json.RawMessage(filteredLlmResponseAsMessageBytes),
		}

		_, err = qtx.CreateMessage(ctx, createMessageParams)
		if err != nil {
			logger.Error("failed to create new message", zap.Error(err))
			return
		}
	}

	updateStepStatusParams := entities.UpdateStepStatusParams{
		ID:          currentStepRecord.ID,
		Status:      string(StepStatusCompleted),
		CompletedAt: sql.NullTime{Time: completedAt, Valid: true},
	}
	_, err = qtx.UpdateStepStatus(ctx, updateStepStatusParams)
	if err != nil {
		logger.Error("failed to update current step", zap.Error(err))
		return
	}

	err = trx.Commit()
	if err != nil {
		logger.Error("failed to commit transaction", zap.Error(err))
		return
	}

	return

}
