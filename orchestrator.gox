package openteam

import (
	"context"
	"database/sql"
	"encoding/json"
	"errors"
	"strings"
	"time"

	"github.com/oklog/ulid/v2"
	"github.com/openai/openai-go/v3/packages/param"
	"github.com/openteam/entities"
	"go.uber.org/zap"
)

var ErrEmptyOrchestrationPlan = errors.New("empty orchestration plan")

type TurnTransferPlan struct {
	replyTaskId       *string
	mentionTaskIds []string
	actingTaskIds     []string
}

func (o *TurnTransferPlan) isOnlyControl() bool {
	return o.replyTaskId == nil && len(o.mentionTaskIds) != 0 && len(o.actingTaskIds) == 0
}

func (o *TurnTransferPlan) isFinalReply() bool {
	return o.replyTaskId != nil && len(o.mentionTaskIds) == 0 && len(o.actingTaskIds) == 0
}

func (o *TurnTransferPlan) isEmpty() bool {
	return o.replyTaskId == nil && len(o.mentionTaskIds) == 0 && len(o.actingTaskIds) == 0
}

func (o *TurnTransferPlan) getFirstTurnId() (turnId string, err error) {
	if o.replyTaskId != nil {
		turnId = *o.replyTaskId
		return
	}

	if len(o.mentionTaskIds) > 0 {
		turnId = o.mentionTaskIds[0]
		return
	}
	if len(o.actingTaskIds) > 0 {
		turnId = o.actingTaskIds[0]
		return
	}

	err = ErrEmptyOrchestrationPlan
	return
}

func transfer121(
	ctx context.Context,
	qtx *entities.Queries,
	currentTurnId string,
	nextTurnKind EventKind,
	nextTurnTaskId string,
	logger *zap.Logger,
) (
	nextTurnId string,
	err error,
) {
	nextTurnRecordParams := entities.CreateTurnParams{
		ID:     ulid.Make().String(),
		TaskID: nextTurnTaskId,
		Kind:   string(nextTurnKind),
		Status: string(TurnStatusPending),
	}
	nextTurnRecord, err := qtx.CreateTurn(ctx, nextTurnRecordParams)
	if err != nil {
		logger.Error("failed to create current turn", zap.Error(err))
		return
	}

	createTurnLinkParams := entities.CreateTurnLinkParams{
		PrevID: currentTurnId,
		NextID: nextTurnRecord.ID,
	}
	_, err = qtx.CreateTurnLink(ctx, createTurnLinkParams)
	if err != nil {
		logger.Error("failed to create turn link", zap.Error(err))
		return
	}

	nextTurnId = nextTurnRecord.ID
	return
}

func (fanOut TurnTransferPlan) transferFanOut(
	ctx context.Context,
	currentTurnId string,
	logger *zap.Logger,
) (
	fanOutTurnIds Plan,
	err error,
) {

	logger = logger.With(zap.String("currentTurnId", currentTurnId))
	logger.Info("getting current turn...")
	currentTurnRecord, err := a.ConversationHistoryDb.Queries.GetTurn(ctx, currentTurnId)
	logger = logger.With(zap.String("currentTurnId", currentTurnRecord.ID))

	logger.Info("getting task of current turn...")
	taskOfcurrentTurnRecord, err := a.ConversationHistoryDb.Queries.GetTaskByTurn(ctx, currentTurnRecord.ID)
	if err != nil {
		logger.Error("failed to get task", zap.Error(err))
		return
	}
	logger = logger.With(zap.String("taskId", taskOfcurrentTurnRecord.ID))

	llmResponseAsMessage, messageId, err := a.llmResponseToMessage(ctx, currentTurnRecord.ID, taskOfcurrentTurnRecord, logger)
	if err != nil {
		logger.Error("failed to get llm response as message", zap.Error(err))
		return
	}

	logger = logger.With(zap.String("messageId", messageId))

	memberRecord, err := a.ConversationHistoryDb.Queries.GetMemberByTask(ctx, taskOfcurrentTurnRecord.ID)
	if err != nil {
		logger.Error("failed to get name", zap.Error(err))
		return
	}

	roleOfcurrentTurnRecord, er := a.ConversationHistoryDb.Queries.GetRoleByTask(ctx, taskOfcurrentTurnRecord.ID)
	err = er
	if err != nil {
		logger.Error("failed to get role", zap.Error(err))
		return
	}

	logger = logger.With(zap.String("roleId", roleOfcurrentTurnRecord.ID))
	logger.Info("getting channel...")

	channelRecord, er := a.ConversationHistoryDb.Queries.GetChannelByRole(ctx, roleOfcurrentTurnRecord.ID)
	err = er
	if err != nil {
		logger.Error("failed to get channel", zap.Error(err))
		return
	}

	completedAt := time.Now().UTC()

	if param.IsOmitted(llmResponseAsMessage.OfAssistant) {
		err = UnexpectedMessageStructureError
		return
	}

	assistantMessage := llmResponseAsMessage.OfAssistant

	trx, err := a.ConversationHistoryDb.DB.BeginTx(ctx, nil)
	if err != nil {
		logger.Error("failed to begin transaction", zap.Error(err))
		return
	}

	defer trx.Rollback()
	qtx := a.ConversationHistoryDb.Queries.WithTx(trx)

	for _, toolCall := range assistantMessage.ToolCalls {
		if param.IsOmitted(toolCall.OfFunction) {
			continue
		}
		function := toolCall.OfFunction
		var args map[string]interface{}
		err = json.Unmarshal([]byte(function.Function.Arguments), &args)
		if err != nil {
			logger.Error("failed to unmarshal articulattion", zap.Error(err))
			return
		}
		if strings.EqualFold(function.Function.Name, addressToAgentFunction.Name) {

			fanOutTurnId, er := a.handleMention(ctx, qtx, currentTurnRecord, function.ID, channelRecord.Name, taskOfcurrentTurnRecord.ID, args, logger)
			err = er
			if err != nil {
				logger.Error("failed to handle mention", zap.Error(err))
				return
			}
			fanOutTurnIds.mentionTurnIds = append(fanOutTurnIds.mentionTurnIds, fanOutTurnId)
		} else {
			err = UnexpectedMessageStructureError
			return
		}
	}

	if !param.IsOmitted(assistantMessage.Content) {
		replyTurnId, er := a.handleReply(ctx, qtx, currentTurnRecord, llmResponseAsMessage, messageId, logger)
		err = er
		if err != nil {
			logger.Error("failed to handle reply", zap.Error(err))
			return
		}
		fanOutTurnIds.replyTaskId = &replyTurnId
		return
	}

	if !fanOutTurnIds.isOnlyControl() {
		logger.Info("persisting message...")

		setName(&llmResponseAsMessage, memberRecord.Name)

		turnIntoUserMessage(&llmResponseAsMessage)

		filteredLlmResponseAsMessage := filterControlToolCalls(llmResponseAsMessage)

		filteredLlmResponseAsMessageBytes, er := json.Marshal(filteredLlmResponseAsMessage)
		err = er
		if err != nil {
			logger.Error("failed to marshal llm response as message", zap.Error(err))
			return
		}

		createMessageParams := entities.CreateMessageParams{
			ID:            messageId,
			Visibility:    string(VisibilityChannel),
			TurnID:        currentTurnRecord.ID,
			ChannelName:   channelRecord.Name,
			RoleID:        roleOfcurrentTurnRecord.ID,
			TaskID:        taskOfcurrentTurnRecord.ID,
			OpenaiMessage: json.RawMessage(filteredLlmResponseAsMessageBytes),
		}

		_, err = qtx.CreateMessage(ctx, createMessageParams)
		if err != nil {
			logger.Error("failed to create new message", zap.Error(err))
			return
		}
	}

	updateTurnStatusParams := entities.UpdateTurnStatusParams{
		ID:          currentTurnRecord.ID,
		Status:      string(TurnStatusCompleted),
		CompletedAt: sql.NullTime{Time: completedAt, Valid: true},
	}
	_, err = qtx.UpdateTurnStatus(ctx, updateTurnStatusParams)
	if err != nil {
		logger.Error("failed to update current turn", zap.Error(err))
		return
	}

	err = trx.Commit()
	if err != nil {
		logger.Error("failed to commit transaction", zap.Error(err))
		return
	}

	return

}
