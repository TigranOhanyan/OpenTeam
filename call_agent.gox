package openteam

import (
	"context"
	"fmt"

	"github.com/oklog/ulid/v2"
	"github.com/openteam/entities"
	"go.uber.org/zap"
)

func (a *Agent) callAgent(
	ctx context.Context,
	currentTurnId string,
	logger *zap.Logger,
) (
	nextTurnId string,
	err error,
) {
	logger = logger.With(zap.String("currentTurnId", currentTurnId))
	logger.Info("getting current turn...")

	currentTurnRecord, err := a.ConversationHistoryDb.Queries.GetTurn(ctx, currentTurnId)
	if err != nil {
		logger.Error("failed to get turn", zap.Error(err))
		return
	}

	switch EventKind(currentTurnRecord.Kind) {
	case EventKindThinking:
		nextTurnId, err = a.withTransaction(ctx, currentTurnRecord, logger, func(ctx context.Context, qtx *entities.Queries, currentTurnId string, logger *zap.Logger) (nextTurnId string, err error) {
			dutyId, err := a.callLLM(ctx, qtx, currentTurnId, logger)
			if err != nil {
				return
			}
			nextTurnId, err = transfer121(ctx, qtx, currentTurnId, EventKindPlanning, dutyId, logger)
			if err != nil {
				return
			}

			return
		})

		if err != nil {
			return
		}

		nextTurnId, err = a.callAgent(ctx, nextTurnId, logger)
		return
	case EventKindPlanning:
		orchestrationPlan, er := a.plan(ctx, currentTurnId, logger)
		err = er
		if err != nil {
			return
		}

		if orchestrationPlan.isFinalReply() {
			currentTurnId = *orchestrationPlan.replyDutyId
			nextTurnId, er = a.callAgent(ctx, currentTurnId, logger)
			if err != nil {
				return
			}
			return
		}

		nextOrchestrationPlan := TurnTransferPlan{
			replyDutyId: orchestrationPlan.replyDutyId,
		}

		for _, addressingTurnId := range orchestrationPlan.addressingTurnIds {
			nextAddrressingTurnId, er := a.callAgent(ctx, addressingTurnId, logger)
			err = er
			if err != nil {
				return
			}
			nextOrchestrationPlan.addressingTurnIds = append(nextOrchestrationPlan.addressingTurnIds, nextAddrressingTurnId)
		}

		for _, actingTurnId := range orchestrationPlan.actingTurnIds {
			nextActingTurnId, er := a.callAgent(ctx, actingTurnId, logger)
			err = er
			if err != nil {
				return
			}
			nextOrchestrationPlan.actingTurnIds = append(nextOrchestrationPlan.actingTurnIds, nextActingTurnId)
		}

		nextTurnId, err = a.summarize(ctx, nextOrchestrationPlan, logger)
		if err != nil {
			return
		}
		nextTurnId, err = a.callAgent(ctx, nextTurnId, logger)
		if err != nil {
			return
		}
		return
	case EventKindActing:
		err = fmt.Errorf("AgentHandoffRequested is not implemented yet")
		return
	case EventKindActed:
		err = fmt.Errorf("AgentHandoffRequested is not implemented yet")
		return
	case EventKindAddressing:
		nextTurnId, err = a.withTransaction(ctx, currentTurnRecord, logger, func(ctx context.Context, qtx *entities.Queries, currentTurnId string, logger *zap.Logger) (nextTurnId string, err error) {
			dutyId, err := a.addressToAgent(ctx, qtx, currentTurnId, logger)
			nextTurnRecordParams := entities.CreateTurnParams{
				ID:     ulid.Make().String(),
				DutyID: dutyId,
				Kind:   string(EventKindThinking),
				Status: string(TurnStatusPending),
			}
			nextTurnRecord, err := qtx.CreateTurn(ctx, nextTurnRecordParams)
			if err != nil {
				logger.Error("failed to create current turn", zap.Error(err))
				return
			}

			createTurnLinkParams := entities.CreateTurnLinkParams{
				PrevID: currentTurnId,
				NextID: nextTurnRecord.ID,
			}
			_, err = qtx.CreateTurnLink(ctx, createTurnLinkParams)
			if err != nil {
				logger.Error("failed to create turn link", zap.Error(err))
				return
			}

			nextTurnId = nextTurnRecord.ID
			return
		})
		if err != nil {
			return
		}
		currentTurnId, err = a.callAgent(ctx, currentTurnId, logger)
		return

	case EventKindReplying:
		currentTurnId, err = a.reply(ctx, currentTurnId, logger)
		if err != nil {
			return
		}
		currentTurnId, err = a.callAgent(ctx, currentTurnId, logger)
		return
	default:
		return "", fmt.Errorf("unknown event kind: %s", currentTurnRecord.Kind)
	}
}

func (a *Agent) withTransaction(
	ctx context.Context,
	currentTurn entities.Turn,
	logger *zap.Logger,
	fn func(ctx context.Context, qtx *entities.Queries, currentTurnId string, logger *zap.Logger) (string, error),
) (nextTurnId string, err error) {
	trx, err := a.ConversationHistoryDb.DB.BeginTx(ctx, nil)
	if err != nil {
		return
	}
	defer func() {
		if err != nil {
			trx.Rollback()
		} else {
			trx.Commit()
		}
	}()

	qtx := a.ConversationHistoryDb.Queries.WithTx(trx)

	nextTurnId, err = fn(ctx, qtx, currentTurn.ID, logger)
	if err != nil {
		return
	}

	return
}
